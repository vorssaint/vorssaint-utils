# Startup latency budget in milliseconds (open app -> menu bar item appears).
VORSSAINT_PERF_STARTUP_BUDGET_MS=2500

# Menu-bar responsiveness budget in milliseconds (status-item click -> panel open).
VORSSAINT_PERF_POPOVER_BUDGET_MS=450

# Probe shape: warmup runs are discarded; measured runs are aggregated by median.
VORSSAINT_PERF_WARMUP_RUNS=1
VORSSAINT_PERF_ITERATIONS=4

# Per-run hard timeouts in milliseconds.
VORSSAINT_PERF_STARTUP_TIMEOUT_MS=12000
VORSSAINT_PERF_POPOVER_TIMEOUT_MS=3000
