/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Vorssaint ใช้การทำงานอัตโนมัติ (Automation) เพื่อย้ายไฟล์ ย้ายรายการไปยังถังขยะ เปิดคำสั่งที่ร้องขอ และควบคุมการเล่นในแอปสื่อของคุณ";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Vorssaint ใช้เสียงของแต่ละแอปเพื่อปรับระดับเสียงในมิกเซอร์ ขยับแถบคลื่นดนตรีของ Dynamic Island และรวมเสียงของ Mac ในการบันทึกหน้าจอที่คุณเริ่ม โดยไม่มีข้อมูลใดออกจาก Mac ของคุณ";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Vorssaint ใช้บลูทูธเพื่ออ่านระดับแบตเตอรี่ของอุปกรณ์ต่อพ่วงที่เชื่อมต่อเท่านั้น โดยไม่มีข้อมูลใดออกจาก Mac ของคุณ";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Vorssaint บันทึกเสียงไมโครโฟนเมื่อคุณเปิดใช้งานสำหรับการบันทึกหน้าจอเท่านั้น เสียงจะคงอยู่บน Mac ของคุณเว้นแต่คุณเลือกที่จะสร้างลิงก์ชั่วคราว";

/* macOS Camera permission prompt. */
