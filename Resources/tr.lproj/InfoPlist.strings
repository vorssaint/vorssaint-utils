/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Vorssaint; dosyaları taşımak, öğeleri Çöp Sepeti’ne göndermek, istenen komutları açmak ve medya uygulamalarınızda oynatmayı denetlemek için Otomasyon kullanır.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Vorssaint, mikserde ses düzeyini ayarlamak, Dynamic Island'ın müzik çubuklarını hareket ettirmek, başlattığınız ekran kayıtlarına Mac'in sesini eklemek ve istediğinizde bir film ya da videodaki şarkıyı tanımak için her uygulamanın sesini kullanır. Bunun için Shazam'a yalnızca bir ses imzası gönderilir; başka hiçbir şey Mac'inizden çıkmaz.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Vorssaint, Bluetooth'u yalnızca bağlı çevre birimlerinin pil düzeyini okumak için kullanır. Hiçbir veri Mac'inden çıkmaz.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Vorssaint mikrofonunuzu yalnızca ekran kaydı için açtığınızda ya da bir şarkıyı tanımasını istediğinizde birkaç saniyeliğine kullanır. Geçici bir bağlantı oluşturmadıkça kayıt Mac’inizde kalır; şarkı için Shazam’a yalnızca bir ses imzası gönderilir.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Vorssaint, kameranızı yalnızca açtığınız önizleme penceresinde gösterir; böylece aramadan önce nasıl göründüğünüzü kontrol edebilirsiniz. Hiçbir şey kaydedilmez veya Mac'inizden çıkmaz.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Vorssaint, yalnızca seçtiğiniz doğrulanmış WhatsApp dosyalarını incelemek, düzenlemek veya Çöp Sepeti'ne taşımak için İndirilenler'deki yerel meta verileri denetler. Ekran görüntülerinizi buraya kaydediyorsanız Temizlik unutulan ekran görüntülerini de arar.";

