/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Vorssaint używa Automatyzacji do przenoszenia plików, wysyłania rzeczy do Kosza, otwierania żądanych poleceń i sterowania odtwarzaniem w aplikacjach multimedialnych.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Vorssaint używa dźwięku poszczególnych aplikacji do regulacji ich głośności w mikserze, animowania słupków muzycznych na Dynamic Island oraz dołączania dźwięku Maca do nagrań ekranu. Nic nie opuszcza Twojego Maca.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Vorssaint używa Bluetooth tylko do sprawdzania poziomu naładowania podłączonych akcesoriów. Nic nie opuszcza Twojego Maca.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Vorssaint nagrywa Twój mikrofon tylko wtedy, gdy włączysz go podczas nagrywania ekranu. Dźwięk pozostaje na Twoim Macu, chyba że zdecydujesz się utworzyć tymczasowe łącze.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Vorssaint pokazuje obraz z kamery tylko w oknie podglądu, aby umożliwić sprawdzenie wyglądu przed rozmową. Nic nie jest nagrywane ani nie opuszcza Twojego Maca.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Vorssaint sprawdza lokalne metadane w Pobranych, aby przejrzeć, uporządkować lub przenieść do Kosza tylko wybrane potwierdzone pliki z WhatsApp. Narzędzie czyszczenia wyszukuje także zapomniane zrzuty ekranu, jeśli zapisujesz je w tym miejscu.";

